---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Recherche" noindex>
  <main
    id="wp--skip-link--target"
    class="wp-block-group has-global-padding is-layout-constrained wp-block-group-is-layout-constrained"
    style="margin-top:var(--wp--preset--spacing--60);padding-bottom:var(--wp--preset--spacing--60)"
    data-search-page
    data-index-url="/search-index.json"
  >
    <h1 class="wp-block-query-title has-text-align-center" data-search-title>Recherche</h1>
    <form method="get" action="/recherche/" class="search-page__form">
      <label class="screen-reader-text" for="search-page-q">Rechercher</label>
      <input id="search-page-q" type="search" name="q" placeholder="Rechercher…" minlength="2" />
      <button class="wp-element-button" type="submit">Rechercher</button>
    </form>
    <p hidden data-search-empty>Aucun résultat.</p>
    <ul class="search-page__results" data-search-results></ul>
  </main>
</BaseLayout>

<script>
  import { search } from '../scripts/search.ts';

  const root = document.querySelector<HTMLElement>('[data-search-page]')!;
  const query = (new URLSearchParams(location.search).get('q') ?? '').trim().slice(0, 100);
  root.querySelector<HTMLInputElement>('#search-page-q')!.value = query;

  if (query.length >= 2) {
    root.querySelector('[data-search-title]')!.textContent = `Résultats pour « ${query} »`;
    document.title = `Recherche : ${query}`;
    const results = await search(root.dataset.indexUrl!, query, 30);
    root.querySelector<HTMLElement>('[data-search-empty]')!.hidden = results.length > 0;
    root.querySelector('[data-search-results]')!.replaceChildren(
      ...results.map((r) => {
        const li = document.createElement('li');
        const a = document.createElement('a');
        a.href = r.url;
        a.textContent = r.title;
        const small = document.createElement('small');
        small.textContent = ` ${r.typeLabel}`;
        const p = document.createElement('p');
        p.textContent = r.excerpt;
        li.append(a, small, p);
        return li;
      }),
    );
  }
</script>
