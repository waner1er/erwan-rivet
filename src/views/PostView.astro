---
import BaseLayout from '../layouts/BaseLayout.astro';
import Cover from '../components/Cover.astro';
import Content from '../components/Content.astro';
import Toc from '../components/Toc.astro';
import PostNav from '../components/PostNav.astro';
import {
  categoryUrl,
  excerptOf,
  firstImage,
  getAdjacentPosts,
  getCategory,
  getPostTags,
  isPlaceholderCover,
  listingPageOf,
  pageUrl,
  POST_TYPES,
  postUrl,
  renderWithToc,
  tagUrl,
  type Post,
} from '../lib/content.ts';
import { articleSchema, breadcrumbSchema } from '../lib/jsonld.ts';

interface Props {
  post: Post;
}

const { post } = Astro.props;
const { html, toc } = renderWithToc(post.content, post.format);
const tags = getPostTags(post.id);
const { prev, next } = getAdjacentPosts(post);
const description = post.meta_description ?? excerptOf(post);
const ogImage = post.cover_image ?? firstImage(html);

// Parent of the post, shown above its title and in the breadcrumb: its listing page
// (Réalisations, Projets personnels), or its category for blog articles.
const listing = listingPageOf(post.type);
const category = post.type === 'post' && post.category_id ? getCategory(post.category_id) : undefined;
const parent = category
  ? { name: category.name, path: categoryUrl(category) }
  : listing
    ? { name: listing.title, path: pageUrl(listing) }
    : undefined;
const eyebrow = post.type === 'post' ? (category?.name ?? POST_TYPES.post.label) : POST_TYPES[post.type].label;

const jsonLd = [
  articleSchema(post, { tags, description, image: ogImage, site: Astro.site, origin: Astro.url.origin }),
  breadcrumbSchema(
    [{ name: 'Accueil', path: '/' }, ...(parent ? [parent] : []), { name: post.title, path: postUrl(post) }],
    Astro.site,
    Astro.url.origin,
  ),
];
---

<BaseLayout title={post.title} description={description} image={ogImage} type="article" jsonLd={jsonLd}>
  <main id="wp--skip-link--target" class="has-global-padding is-layout-constrained">
    <article class:list={['wan-post alignwide', { 'has-media': post.cover_image }]}>
      <Cover title={post.title} eyebrow={eyebrow} eyebrowUrl={parent?.path}>
        {post.excerpt && <p class="wan-lead wan-rise-3">{post.excerpt}</p>}
        {
          tags.length > 0 && (
            <ul class="wan-tags" aria-label="Mots-clés">
              {tags.map((tag) => (
                <li>
                  <a href={tagUrl(tag)} rel="tag">
                    {tag.name}
                  </a>
                </li>
              ))}
            </ul>
          )
        }
      </Cover>
      {
        post.cover_image && (
          <aside class="wan-post__media">
            {isPlaceholderCover(post.cover_image) ? (
              <div class="wan-wordmark wan-float" aria-hidden="true">
                <strong>{post.title}</strong>
              </div>
            ) : (
              <figure class="wan-photo wan-float">
                <img src={post.cover_image} alt="" decoding="async" fetchpriority="high" />
              </figure>
            )}
          </aside>
        )
      }
      <time datetime={post.published_at ?? post.created_at} class="screen-reader-text">{post.published_at ?? post.created_at}</time>
      <div class="wan-section wan-post__body is-layout-flow">
        {post.show_toc === 1 && <Toc items={toc} />}
        <div class="entry-content wan-post-body is-layout-flow">
          <Content html={html} />
        </div>
      </div>
    </article>
    <div class="wan-section alignwide">
      <PostNav prev={prev} next={next} />
    </div>
  </main>
</BaseLayout>
