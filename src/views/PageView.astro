---
import BaseLayout from '../layouts/BaseLayout.astro';
import Cover from '../components/Cover.astro';
import Content from '../components/Content.astro';
import CategoryPosts from '../components/CategoryPosts.astro';
import PostGrid from '../components/PostGrid.astro';
import { firstImage, getPostTags, LIST_SECTIONS, listCategories, listPosts, renderBody, stripHtml, truncateWords, type Page } from '../lib/content.ts';
import { pageSchema } from '../lib/jsonld.ts';

interface Props {
  page: Page;
}

const { page } = Astro.props;
const html = renderBody(page.content, page.format);
const description = page.meta_description ?? truncateWords(stripHtml(html), 25);
const isHome = page.slug === '';
const ogImage = page.cover_image ?? firstImage(html);

// Listing pages: posts grouped by section tag (see LIST_SECTIONS), the rest under "Autres".
const listed = page.template === 'list' ? listPosts({ type: page.list_type ?? 'realisation' }) : [];
const sectionDefs = LIST_SECTIONS[page.list_type ?? 'realisation'] ?? [];
const sectionOf = (postId: number) => {
  const slugs = getPostTags(postId).map((t) => t.slug);
  return sectionDefs.find((d) => slugs.includes(d.tag))?.tag;
};
const sections = [
  ...sectionDefs.map((d) => ({ ...d, posts: listed.filter((p) => sectionOf(p.id) === d.tag) })),
  { tag: 'autres', title: sectionDefs.length ? 'Autres' : '', intro: '', posts: listed.filter((p) => !sectionOf(p.id)) },
].filter((sec) => sec.posts.length > 0);
const jsonLd = pageSchema(page, { description, image: ogImage, site: Astro.site, origin: Astro.url.origin });
---

<BaseLayout title={isHome ? undefined : page.title} description={description} image={ogImage} jsonLd={jsonLd}>
  {
    page.template === 'default' && (
      <main id="wp--skip-link--target" class="entry-content has-global-padding is-layout-constrained">
        <Content html={html} />
      </main>
    )
  }

  {
    page.template === 'raw' && (
      <main id="wp--skip-link--target">
        <Content html={html} />
      </main>
    )
  }

  {
    page.template === 'cover' && (
      <main id="wp--skip-link--target" class="has-global-padding is-layout-constrained">
        <Cover title={page.title} image={page.cover_image} eyebrow={page.title} />
        <div class="wan-section alignwide is-layout-constrained wan-constrained-left">
          <div class="entry-content is-layout-flow">
            <Content html={html} />
          </div>
        </div>
      </main>
    )
  }

  {
    page.template === 'blog' && (
      <main id="wp--skip-link--target" class="has-global-padding is-layout-constrained">
        <Cover title={page.title} eyebrow={page.title}>
          <Content html={html} />
        </Cover>
        <div class="wan-section alignwide">
          <CategoryPosts terms={listCategories().filter((c) => !c.parent_id)} />
        </div>
      </main>
    )
  }

  {
    page.template === 'list' && (
      <main id="wp--skip-link--target" class="has-global-padding is-layout-constrained">
        <Cover title={page.title} eyebrow={page.title}>
          <Content html={html} />
        </Cover>
        {sections.map((section) => (
          <section class="wan-section alignwide wan-list-section is-layout-flow" id={section.tag}>
            {section.title && <h2>{section.title}</h2>}
            {section.intro && <p class="wan-list-section__intro">{section.intro}</p>}
            <PostGrid posts={section.posts} headingLevel={section.title ? 3 : 2} />
          </section>
        ))}
      </main>
    )
  }
</BaseLayout>
