---
import BaseLayout from '../layouts/BaseLayout.astro';
import Cover from '../components/Cover.astro';
import CategoryPosts from '../components/CategoryPosts.astro';
import { childCategories, type Category } from '../lib/content.ts';
import { sanitizeContentHtml } from '../lib/sanitize.ts';

interface Props {
  category: Category;
}

const { category } = Astro.props;
const hasChildren = childCategories(category.id).length > 0;
---

<BaseLayout title={category.name} description={category.description}>
  <main id="wp--skip-link--target" class="has-global-padding is-layout-constrained">
    <Cover title={category.name} eyebrow="Blog">
      {category.description && <div class="wan-lead" set:html={sanitizeContentHtml(category.description)} />}
    </Cover>
    <section class="wan-section alignwide">
      {
        hasChildren ? (
          <CategoryPosts terms={[category]} columns={3} childColumns={1} postColumns={1} showTermHeader={false} showDate />
        ) : (
          <CategoryPosts terms={[category]} leaf columns={3} postColumns={3} showDate />
        )
      }
    </section>
  </main>
</BaseLayout>
