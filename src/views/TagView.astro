---
import BaseLayout from '../layouts/BaseLayout.astro';
import Cover from '../components/Cover.astro';
import CategoryPosts from '../components/CategoryPosts.astro';
import PostGrid from '../components/PostGrid.astro';
import { listCategories, listPosts, type Tag } from '../lib/content.ts';

interface Props {
  tag: Tag;
}

const { tag } = Astro.props;
const hasBlogPosts = listPosts({ type: 'post', tagId: tag.id, limit: 1 }).length > 0;
// Réalisations, travaux and projets carrying the tag are listed too.
const others = listPosts({ tagId: tag.id }).filter((p) => p.type !== 'post');
---

<BaseLayout title={tag.name}>
  <main id="wp--skip-link--target" class="has-global-padding is-layout-constrained">
    <Cover title={tag.name} eyebrow="Mot-clé" />
    <section class="wan-section alignwide is-layout-flow">
      {
        hasBlogPosts && (
          <CategoryPosts
            terms={listCategories().filter((c) => !c.parent_id)}
            columns={1}
            childColumns={1}
            postColumns={1}
            showThumb={false}
            showDate
            showMore={false}
            tagId={tag.id}
          />
        )
      }
      {others.length > 0 && <PostGrid posts={others} headingLevel={2} />}
      {!hasBlogPosts && others.length === 0 && <p>Aucun contenu pour ce mot-clé.</p>}
    </section>
  </main>
</BaseLayout>
