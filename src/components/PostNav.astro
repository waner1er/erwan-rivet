---
import { postUrl, type Post } from '../lib/content.ts';

interface Props {
  prev?: Post;
  next?: Post;
}

const { prev, next } = Astro.props;
---

{
  (prev || next) && (
    <nav class="wan-post-nav alignwide" aria-label="Navigation des publications">
      {prev && (
        <a class="wan-post-nav__prev" href={postUrl(prev)} rel="prev">
          <span>← Précédent</span>
          {prev.title}
        </a>
      )}
      {next && (
        <a class="wan-post-nav__next" href={postUrl(next)} rel="next">
          <span>Suivant →</span>
          {next.title}
        </a>
      )}
    </nav>
  )
}
