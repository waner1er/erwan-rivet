---
// Page / post hero of the theme: eyebrow, title, optional lead (slot) and illustration on the right.
interface Props {
  title: string;
  image?: string | null;
  /** Small label above the title (e.g. "Réalisation"), linked when `eyebrowUrl` is set. */
  eyebrow?: string;
  eyebrowUrl?: string;
}

const { title, image, eyebrow, eyebrowUrl } = Astro.props;
const hasLead = Astro.slots.has('default');
---

<section class="wan-hero alignwide is-layout-flow">
  {
    image ? (
      <div class="wp-block-columns wan-split">
        <div class="wp-block-column is-layout-flow">
          {eyebrow && <p class="wan-eyebrow wan-rise">{eyebrowUrl ? <a href={eyebrowUrl}>{eyebrow}</a> : eyebrow}</p>}
          <h1 class="wan-rise-2">{title}</h1>
          {hasLead && <slot />}
        </div>
        <div class="wp-block-column">
          <figure class="wan-photo wan-illus wan-float">
            <img src={image} alt="" decoding="async" fetchpriority="high" />
          </figure>
        </div>
      </div>
    ) : (
      <>
        {eyebrow && <p class="wan-eyebrow wan-rise">{eyebrowUrl ? <a href={eyebrowUrl}>{eyebrow}</a> : eyebrow}</p>}
        <h1 class="wan-rise-2">{title}</h1>
        {hasLead && <slot />}
      </>
    )
  }
</section>

