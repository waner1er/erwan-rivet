---
import { excerptOf, isPlaceholderCover, postUrl, truncateWords, type Post } from '../lib/content.ts';

interface Props {
  posts: Post[];
  /** "cards": project cards, 3 columns (réalisations, projets). "square": 2-column square thumbnails. */
  variant?: 'cards' | 'square';
  /** Level of the card titles, one below the heading introducing the grid. */
  headingLevel?: 2 | 3;
}

const { posts, variant = 'cards', headingLevel = 3 } = Astro.props;
const Heading = `h${headingLevel}`;
---

{
  variant === 'cards' ? (
    <div class="wan-cards alignwide is-layout-grid wan-grid-fit" style="--wan-cols:3;--wan-min:16rem">
      {posts.map((post) => (
        <article class="wan-card wan-card--link">
          {post.cover_image &&
            (isPlaceholderCover(post.cover_image) ? (
              <div class="wan-card__thumb wan-wordmark" aria-hidden="true">
                <strong>{post.title}</strong>
              </div>
            ) : (
              <figure class="wan-card__thumb">
                <img src={post.cover_image} alt="" decoding="async" loading="lazy" />
              </figure>
            ))}
          <Heading>
            <a href={postUrl(post)}>{post.title}</a>
          </Heading>
          <p>{truncateWords(excerptOf(post), 30)}</p>
        </article>
      ))}
    </div>
  ) : (
    <div class="wp-block-query alignwide is-layout-flow wp-block-query-is-layout-flow">
      <ul class="columns-2 has-native-responsive-grid wp-block-post-template is-layout-grid wan-grid-auto wp-block-post-template-is-layout-grid">
        {posts.map((post) => (
          <li class="wp-block-post">
            <div class="wp-block-group is-vertical is-content-justification-center is-layout-flex wan-stack-items-center wp-block-group-is-layout-flex">
              <h2 class="wp-block-post-title">{post.title}</h2>
              {post.cover_image && (
                <figure class="wp-block-post-featured-image">
                  <a href={postUrl(post)}>
                    <img src={post.cover_image} class="wp-post-image" alt={post.title} style="aspect-ratio:1;height:auto;width:360px;max-width:100%;object-fit:cover;" decoding="async" loading="lazy" />
                  </a>
                </figure>
              )}
              <div class="wp-block-post-excerpt">
                <p class="wp-block-post-excerpt__excerpt">{truncateWords(excerptOf(post, 55), 55)}</p>
              </div>
            </div>
          </li>
        ))}
      </ul>
    </div>
  )
}
